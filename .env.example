# Neon PostgreSQL — pooled connection (prisma queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL — direct (non-pooled) connection for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Razorpay (server only — never prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Public Razorpay key is required by Checkout.js
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Admin bootstrap (password is stored as a bcrypt hash, never plaintext in client code)
ADMIN_USERNAME="AdminGp@314"
ADMIN_PASSWORD_HASH=""

# Signed session cookie
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
